                      "alphaIsTransparency":  false,
                      "wrapU":  "Repeat",
                      "wrapV":  "Clamp",
                      "maxSize":  8192,
                      "compression":  "CompressedHQ",
                      "aniso":  4,
                      "readable":  false
                  },
