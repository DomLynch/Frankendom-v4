  "hingeRom": {
    "_about": "PHYSFLINCH v1: ragdoll hinge windows (parts[].hinge.min / .max, absolute flexion degrees, 0 = straight) are the RANGE OF MOTION of the shipped clips + marginDeg, computed by Tools-free script _agents/lanePHYSFLINCH/tools/phys_hinge_rom.py (python phys_hinge_rom.py --write-data <overlay>). Not the rest pose. hyperFloorDeg = how far a joint may bend the wrong way whatever a twisted-grip clip does; planeMinCos = a bend counts as hyper-extension only when its plane is the hinge plane.",
    "enabled": true,
    "marginDeg": 6.0,
    "sampleHz": 30.0,
    "planeMinCos": 0.5,
    "parts": [
      "forearmL",
      "forearmR",
      "shinL",
      "shinR"
    ],
    "hyperFloorDeg": {
      "forearmL": -30.0,
      "forearmR": -30.0,
      "shinL": -3.2,
      "shinR": -3.2
    },
    "clipGlobs": [
      "Assets/Characters/*/*_anim.glb",
      "Assets/Characters/*/*_attacks_v2.glb",
      "Assets/Characters/*/*_dodges.glb",
      "Assets/Characters/Joan/Joan_finishers.glb"
    ]
  },
