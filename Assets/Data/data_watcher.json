  "skip": [
    {
      "file": "roster.json",
      "reason": "Roster.Reload() replaces the whole roster object and defEnemy; live fighters, the ladder and ZoneRuntime hold the old RosterCharacter rows and ids, so a swap mid-run can leave player/enemy ids that no fighter matches. Restart."
    },
    {
      "file": "zones.json",
      "reason": "ZoneData.Reload() nulls the table while ZoneRuntime iterates spots/spawns/gates it already resolved and holds spawned creatures by reference: half-new state (spawns, engage rules, respawn timers). Restart."
    },
    {
      "file": "zones_save.json",
      "reason": "SAVE FILE written by the game itself (ZoneSave): never watch or reload, a reload would fight the autosave."
    },
    {
      "file": "loot_save.json",
      "reason": "SAVE FILE written by the game itself (loot save): never watch or reload."
    },
    {
      "file": "zone_span.json",
      "reason": "SpanData.Reload() resets terrain numbers, but the terrain and zone offsets are BAKED (flat/flatY) and ZoneSpan.Live streams by them: a live change would disagree with the baked scene. CHAIN item, restart."
    },
    {
      "file": "character_materials.json",
      "reason": "already watched by CharMatOverride and MonsterLook (their own file-time pollers call their internal Reload); a second caller would double-apply."
    },
    {
      "file": "(GameLoop.ReloadForStart)",
      "reason": "restarts the fight (the ladder start reload), not a data reload: never call it from a watcher."
    },
    {
      "file": "props_layout*.json, lod_tex_map.json, hdrp_fixes.json, camp_backdrop.json",
      "reason": "BAKED into the scene by the chain: no runtime reader, no Reload (AGENTS.md Known BAKED items)."
    }
  ]
