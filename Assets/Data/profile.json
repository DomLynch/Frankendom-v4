{
  "_about": "PROFILE v104 (laneOPT4). Switch for -profile (ProfileMode.cs). enabled=false ships: with it off, or without -profile, nothing runs. run_profile.py passes a copy with enabled=true through -profiledata. counters[].names are tried in order; '~x' = first marker whose name contains x; the matched name and status per column land in profile_meta.json, the build's full marker list in profile_markers.txt, so a wrong guess is fixed here, not in code. kind: ms (nanosecond marker -> ms), count, bytes. warmup/measure seconds default to the run_res_ab.py window (20 / 45).",
  "enabled": false,
  "warmupSeconds": 20.0,
  "measureSeconds": 45.0,
  "minWarmupFrames": 120,
  "maxFrames": 20000,
  "quitWhenDone": true,
  "listMarkers": true,
  "frameTiming": true,
  "passes": true,
  "companionArgs": [
    "-balanceauto",
    "-perfab",
    "-perfbench"
  ],
  "quitBlockers": [
    "-balanceauto",
    "-perfab"
  ],
  "outDirName": "profile",
  "counters": [
    {
      "col": "draw_calls",
      "names": [
        "Draw Calls Count"
      ],
      "kind": "count"
    },
    {
