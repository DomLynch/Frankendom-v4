     void OnLoaded(Scene s, LoadSceneMode m) { if (Open) ForceClose(); pendingUnfreeze = false; ownFreeze = false; }
+
+    // ---------------- F5 BOOTMENU (menu.json boot{}, default off) ----------------
+    bool bootPending, bootMode; float bootT0 = -1f, bootClear = -1f;
+    void ArmBoot()
+    {
+        var B = MenuCfg.Get().boot; bootPending = false;
+        if (B == null || !B.enabled || !Enabled) return;
+        foreach (var a in Environment.GetCommandLineArgs()) foreach (var s in B.skipArgs) if (!string.IsNullOrEmpty(s) && a.StartsWith(s, StringComparison.OrdinalIgnoreCase)) { Debug.Log("[MenuUI] boot menu off: " + a); return; }
+        bootPending = true; Debug.Log("[MenuUI] boot menu armed");
+    }
+    void BootTick(MenuCfg.Data C)
+    {
+        var B = C.boot; float now = Time.unscaledTime; if (bootT0 < 0f) bootT0 = now;
+        if (now - bootT0 > B.maxWaitS) { bootPending = false; Debug.Log("[MenuUI] boot menu gave up after " + B.maxWaitS.ToString("F0") + " s"); return; }
+        if (!LoadingCard.Cleared || !StartupWarm.Done) { bootClear = -1f; return; }   // the card and the cover are gone: the world is really there
+        if (bootClear < 0f) bootClear = now;
+        if (now - bootClear < B.afterCardS || !Allowed() || !ClockReady()) return;
+        bootPending = false; bootMode = true; OpenMenu(); Debug.Log("[MenuUI] boot menu opened");
+    }
 
