{
  "_about": "HCKIT3 v93: every number the gate used to hard-code (Tools/gate.ps1 + gate_lean.ps1), read by Tools/gate_unified.ps1 and Tools/qc_visual.py. A step runs when its 'profiles' contains the chosen -Profile (full|lean) OR its 'proof' name is in -proofs (e.g. -proofs loop,cam). Order = list order = the order gate.ps1/gate_lean.ps1 ran them. Flags tokens: {out} = the step's outDir, {flagsPath} = <build>/<exe>_Data/StreamingAssets/runtime_flags_balance.json. 'res' is a key of 'resolutions'. A stale outDir is MOVED aside to <outDir>_prev_<time>, never deleted.",
  "pythonExe": "python",
  "qcScript": "Tools/qc_visual.py",
  "memKillGB": 20,
  "pollSec": 2,
  "memLogEverySec": 10,
  "resolutions": { "default": [1920, 1080], "low": [1280, 720] },
  "commonFlags": [ "-silent-crashes", "-screen-fullscreen 0" ],
  "outputs": { "memLog": "gate_mem.log", "runSummary": "gate_run.txt", "doneMarker": "gate_done.txt", "qcReport": "qc_visual.txt" },
  "steps": [
    { "name": "verify",   "log": "verify_player",   "flags": [ "-verifyGround", "-verifyOut:{out}" ], "outDir": "verify_out", "timeoutSec": 420, "res": "default", "profiles": [ "full", "lean" ] },
    { "name": "balance_1234", "log": "balance_player",  "flags": [ "-balanceauto", "-seeds:5", "-balanceseed:1234", "-fast", "-flags:{flagsPath}" ], "timeoutSec": 1900, "res": "low", "profiles": [ "full" ], "copyAfter": { "from": "balance_summary.txt", "to": "balance_summary_1234.txt" } },
    { "name": "balance_1239", "log": "balance_player2", "flags": [ "-balanceauto", "-seeds:5", "-balanceseed:1239", "-fast", "-flags:{flagsPath}" ], "timeoutSec": 1900, "res": "low", "profiles": [ "full" ], "copyAfter": { "from": "balance_summary.txt", "to": "balance_summary_1239.txt" } },
    { "name": "balance_lean", "log": "balance_player",  "flags": [ "-balanceauto", "-seeds:5", "-fast", "-flags:{flagsPath}" ], "timeoutSec": 1000, "res": "low", "profiles": [ "lean" ] },
    { "name": "finisher", "log": "finisher_player", "flags": [ "-finisherauto" ], "timeoutSec": 400, "res": "default", "profiles": [ "full" ], "proof": "finisher" },
    { "name": "posture",  "log": "posture_player",  "flags": [ "-postureproof", "-proofsecs:120" ], "outDir": "posture_proof", "timeoutSec": 300, "res": "default", "profiles": [ "full" ], "proof": "posture" },
    { "name": "flow",     "log": "flow_player",     "flags": [ "-flowproof" ], "outDir": "flow_proof", "timeoutSec": 300, "res": "default", "profiles": [ "full" ], "proof": "flow" },
    { "name": "cam",      "log": "cam_player",      "flags": [ "-camproof" ], "outDir": "camproof", "timeoutSec": 300, "res": "default", "profiles": [ "full" ], "proof": "cam" },
    { "name": "loop",     "log": "loop_player",     "flags": [ "-looptest", "-loopout:{out}" ], "outDir": "loop_out", "timeoutSec": 400, "res": "default", "profiles": [], "proof": "loop" }
  ],
  "qc": {
    "_about": "Tools/qc_visual.py thresholds (were literals in the script). A brighter new arena/monster level may need these raised HERE, not in code.",
    "p1Max": 0.040,
    "meanMax": 0.280,
    "contrastMin": 0.500,
    "sampleCaps": { "verify": 10, "fight": 5, "cam": 5 },
    "globs": { "verify": "verify_out/*_game.png", "fight": "verify_out/fight_*.png", "cam": "camproof/cam_*.png" },
    "failLogStrings": [ "HDRP/Decal shader missing", "using bone-parented quads" ]
  }
}
